{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Model Config Schema",
  "type": "object",
  "description": "Schema for configuring LLM provider settings, parameters, and token costs.",
  "properties": {
    "config_id": {
      "type": "string"
    },
    "model_name": {
      "type": "string"
    },
    "provider": {
      "type": "string",
      "enum": [
        "openai",
        "anthropic",
        "google",
        "azure",
        "local_ollama",
        "custom"
      ]
    },
    "api_base": {
      "type": "string"
    },
    "max_context_window": {
      "type": "integer"
    },
    "default_temperature": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 2.0
    },
    "timeout_ms": {
      "type": "integer"
    },
    "cost_per_1k_input_tokens": {
      "type": "number"
    },
    "cost_per_1k_output_tokens": {
      "type": "number"
    }
  },
  "required": [
    "config_id",
    "model_name",
    "provider",
    "max_context_window",
    "default_temperature",
    "timeout_ms"
  ]
}