{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Decision Record Schema",
  "type": "object",
  "description": "Schema for structured decision records generated by the AI OS Decision Engine.",
  "properties": {
    "decision_id": {
      "type": "string"
    },
    "agent_id": {
      "type": "string"
    },
    "context_id": {
      "type": "string"
    },
    "topic": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "alternatives_considered": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "option_id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "pros": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "score": {
            "type": "number"
          }
        },
        "required": [
          "option_id",
          "description"
        ]
      }
    },
    "rationale": {
      "type": "string"
    },
    "chosen_option": {
      "type": "string"
    },
    "risk_assessment": {
      "type": "object",
      "properties": {
        "risk_level": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "mitigation": {
          "type": "string"
        }
      }
    },
    "confidence_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "approved",
        "rejected",
        "superseded"
      ]
    },
    "require_approval": {
      "type": "boolean"
    },
    "approved_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "decision_id",
    "agent_id",
    "topic",
    "chosen_option",
    "rationale",
    "timestamp"
  ]
}