{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Permission Specification Schema",
  "type": "object",
  "description": "Schema defining granular permissions for resource operations.",
  "properties": {
    "permission_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "resource": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "create",
        "read",
        "update",
        "delete",
        "execute",
        "admin"
      ]
    },
    "conditions": {
      "type": "object"
    },
    "description": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    }
  },
  "required": [
    "permission_id",
    "name",
    "resource",
    "action",
    "scope"
  ]
}