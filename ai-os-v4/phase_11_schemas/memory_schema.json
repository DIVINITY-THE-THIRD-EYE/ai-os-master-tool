{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Memory Entry Schema",
  "type": "object",
  "description": "Schema for memory records stored in working, persistent, or vector memory.",
  "properties": {
    "memory_id": {
      "type": "string"
    },
    "agent_id": {
      "type": "string"
    },
    "memory_type": {
      "type": "string",
      "enum": [
        "working",
        "session",
        "persistent",
        "project",
        "agent",
        "reflection",
        "learning"
      ]
    },
    "content": {
      "type": "string"
    },
    "vector_embedding": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Dense embedding vector."
    },
    "importance_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "access_count": {
      "type": "integer",
      "minimum": 0
    },
    "last_accessed_at": {
      "type": "string",
      "format": "date-time"
    },
    "ttl_seconds": {
      "type": [
        "integer",
        "null"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "object"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "memory_id",
    "agent_id",
    "memory_type",
    "content",
    "importance_score",
    "created_at"
  ]
}