{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Role Specification Schema",
  "type": "object",
  "description": "Schema for RBAC roles assigned to users or agents.",
  "properties": {
    "role_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "type": "string",
      "enum": [
        "system",
        "organization",
        "project"
      ]
    },
    "inherited_roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "role_id",
    "name",
    "permissions",
    "scope",
    "created_at"
  ]
}