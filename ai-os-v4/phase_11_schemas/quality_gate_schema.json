{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Quality Gate Schema",
  "type": "object",
  "description": "Schema defining quality gate standards and gating criteria.",
  "properties": {
    "gate_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "phase": {
      "type": "string"
    },
    "min_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 100.0
    },
    "mandatory_checkers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocking": {
      "type": "boolean"
    },
    "failure_action": {
      "type": "string",
      "enum": [
        "reject",
        "warn",
        "escalate",
        "override"
      ]
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "gate_id",
    "name",
    "phase",
    "min_score",
    "mandatory_checkers",
    "blocking",
    "failure_action"
  ]
}