{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Kernel Config Schema",
  "type": "object",
  "description": "Schema for AI OS Core Runtime Kernel configuration.",
  "properties": {
    "kernel_id": {
      "type": "string"
    },
    "environment": {
      "type": "string",
      "enum": [
        "development",
        "staging",
        "production",
        "test"
      ]
    },
    "log_level": {
      "type": "string",
      "enum": [
        "DEBUG",
        "INFO",
        "WARN",
        "ERROR",
        "FATAL"
      ]
    },
    "max_parallel_agents": {
      "type": "integer",
      "minimum": 1
    },
    "heartbeat_interval_ms": {
      "type": "integer",
      "minimum": 100
    },
    "plugin_directory": {
      "type": "string"
    },
    "storage_backend": {
      "type": "string",
      "enum": [
        "memory",
        "sqlite",
        "postgresql",
        "redis",
        "s3"
      ]
    },
    "event_bus_config": {
      "type": "object"
    },
    "status": {
      "type": "string",
      "enum": [
        "starting",
        "running",
        "degraded",
        "stopping",
        "stopped"
      ]
    }
  },
  "required": [
    "kernel_id",
    "environment",
    "log_level",
    "max_parallel_agents",
    "storage_backend",
    "status"
  ]
}