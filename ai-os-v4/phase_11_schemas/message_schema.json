{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Inter-Agent Message Schema",
  "type": "object",
  "description": "Schema for Agent Communication Protocol (ACP) messages.",
  "properties": {
    "message_id": {
      "type": "string"
    },
    "sender_id": {
      "type": "string"
    },
    "recipient_id": {
      "type": "string"
    },
    "conversation_id": {
      "type": "string"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "request",
        "response",
        "broadcast",
        "handshake",
        "heartbeat",
        "error"
      ]
    },
    "content": {
      "type": "string"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "sent",
        "delivered",
        "read",
        "failed"
      ]
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    }
  },
  "required": [
    "message_id",
    "sender_id",
    "recipient_id",
    "conversation_id",
    "message_type",
    "content",
    "timestamp"
  ]
}